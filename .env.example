# Copy to .env (or export these) to configure repo-qa.

# Where the central index lives (default: ~/.repo-qa/index.db)
# REPO_QA_DB=~/.repo-qa/index.db

# Embedding provider: fastembed (default, local ONNX) or mock (deterministic, for tests)
# REPO_QA_EMBEDDER=fastembed
# REPO_QA_EMBED_MODEL=BAAI/bge-small-en-v1.5

# LLM provider: mock (default, offline), anthropic, or openai
# REPO_QA_LLM=anthropic
# REPO_QA_LLM_MODEL=claude-sonnet-5-5

# API keys (only needed for the matching provider)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
